GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# GOOGLE_API_KEY is also supported for local compatibility.
# GOOGLE_API_KEY=your_gemini_api_key_here

# Optional product settings
ATLAS_ENV=development
ATLAS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:3000,http://localhost:3001
ATLAS_SESSION_TTL_SECONDS=604800
ATLAS_MAX_CSV_UPLOAD_BYTES=262144000
# Production database connections require exact hostnames in this list.
ATLAS_DATABASE_HOST_ALLOWLIST=
# Set ATLAS_ENV=production, a long random secret, and ATLAS_COOKIE_SECURE=true for deployment.
ATLAS_SESSION_SECRET=replace_with_a_different_long_random_secret
ATLAS_COOKIE_SECURE=false

# Used to encrypt stored database credentials.
# In production, set this from a secret manager.
# If omitted locally, AtlasAI creates backend/.atlas_secret automatically.
ATLAS_SECRET_KEY=replace_with_a_long_random_secret
